# --- DRY_RUN (verify the plumbing with no credentials) ---
# true  = app/sim_broker.py replaces the Tradovate client. The full webhook ->
#         risk -> bracket -> submit path still runs, orders are recorded to
#         state/sim_orders.json, and nothing can reach the broker.
# false = real REST calls (requires the three credentials below).
DRY_RUN=false

# --- Tradovate credentials (from https://developer.tradovate.com -> "Apps") ---
TRADOVATE_ENV=demo                       # demo | live
TRADOVATE_APP_ID=your_app_id
TRADOVATE_CID=your_cid
TRADOVATE_SEC=your_sec
TRADOVATE_APP_VERSION=1.0

# --- Account ---
TRADOVATE_ACCOUNT_ID=                    # numeric Tradovate account id (from /account/list)
TRADOVATE_ACCOUNT_SPEC=Trials            # "Trials" for Apex sim, "Apex" for funded

# --- Webhook auth (TradingView alert -> middleware) ---
WEBHOOK_API_KEY=change-me-to-a-long-random-string
WEBHOOK_PATH=/webhook/tradingview

# The TradingView alert dialog cannot set custom headers, so the shared secret
# may also travel in the URL (path or query):
#   https://host/webhook/tradingview/<WEBHOOK_API_KEY>
# Terminate TLS in front of this service and keep the URL secret. Set to false
# once a reverse proxy injects X-API-Key, which is the stronger arrangement.
ALLOW_URL_KEY=true

# Optional: comma-separated source IPs allowed to use URL-embedded keys.
# Empty = any source IP (fine while the only caller is localhost). Once a real
# alert has landed, pin the source from the nginx access log — or from the
# middleware's "URL-key webhook rejected from non-allowlisted IP <ip>" line —
# so a leaked alert URL is useless from anywhere else. Header auth is not
# IP-checked; this guard only applies to the URL carrier.
TRADINGVIEW_IP_ALLOWLIST=

# --- Apex risk limits (50k account defaults; scale for 100k/150k) ---
MAX_DAILY_LOSS_USD=1500                  # hard ceiling; 0 disables
TRAILING_DRAWDOWN_USD=2000               # intraday HWM buffer; abort if breached
MAX_CONTRACTS_PER_ORDER=2                # per-symbol cap (Apex 50k = 2 minis)
MAX_TOTAL_OPEN_POSITIONS=2
DUPLICATE_SIGNAL_WINDOW_SEC=5

# --- Order construction ---
DEFAULT_STOP_TICKS=40                    # used when signal omits stop_loss
DEFAULT_TP_TICKS=80
TICK_SIZE_NQ=0.25
TICK_VALUE_NQ=20
REQUIRE_EXPLICIT_STOP=true               # reject signals with no stop_loss

# --- Runtime ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
STATE_FILE=./state/risk_state.json
KILL_SWITCH_FILE=./state/KILL_SWITCH
TOKEN_REFRESH_MARGIN_SEC=300
